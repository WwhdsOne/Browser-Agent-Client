{
  "name": "wbrowser-gui-agent",
  "version": "1.0.0",
  "description": "WBrowserGUI_AGENT - GUI智能体前后端协同执行系统客户端",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.js",
    "electron:dev": "concurrently \"pnpm run build:electron --watch\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "pnpm run build && pnpm run build:electron && electron-builder"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/tsconfig": "^0.4.0",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.wbrowser.gui-agent",
    "productName": "WBrowserGUI_AGENT",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
